# Copiar como .streamlit/secrets.toml (local) o pegar en
# Streamlit Cloud > App settings > Secrets. NUNCA subir secrets.toml al repositorio.

[credentials]
usuario = "admin"
# Recomendado: hash generado con `python generar_hash.py`
password_hash = "pbkdf2_sha256$600000$...$..."
# Alternativa (menos segura, compatible con la versión anterior):
# password = "mi-contraseña"

[auth]
timeout_minutos = 30
